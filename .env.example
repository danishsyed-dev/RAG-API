# =============================================================================
# RAG-API Configuration
# Copy this file to `.env` and modify as needed.
# =============================================================================

# --- Database ---
# Path to the ChromaDB persistent storage directory
CHROMADB_PATH=./db

# Name of the ChromaDB collection
COLLECTION_NAME=docs

# --- LLM ---
# Ollama model to use for generation
LLM_MODEL=tinyllama

# Ollama server URL
OLLAMA_HOST=http://localhost:11434

# Set to 1 to use mock LLM mode (returns raw context, no LLM call)
USE_MOCK_LLM=0

# --- API ---
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=*

# Maximum allowed query length in characters
MAX_QUERY_LENGTH=1000

# Default number of context chunks to retrieve per query
DEFAULT_N_RESULTS=3

# --- Ingestion ---
# Number of characters per chunk when splitting documents
CHUNK_SIZE=500

# Number of overlapping characters between chunks
CHUNK_OVERLAP=50
